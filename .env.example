# ==============================================================================
# Touchline Environment Variables
# ==============================================================================

# Database Connection URL (PostgreSQL / Supabase / Neon)
# Masukkan connection string database PostgreSQL Anda di sini dan di Vercel Environment Variables:
# 
# Contoh Supabase:
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# Contoh Neon:
# DATABASE_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT].neon.tech/[DATABASE]?sslmode=require"
#
# Contoh Database Lokal Postgres:
DATABASE_URL="postgresql://postgres:password@localhost:5432/touchline?schema=public"
